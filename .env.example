# Execution
# DRY_RUN=true (default) simulates everything with no keys/network.
# Set to "false" to route orders to the Binance Agent OS MCP server.
DRY_RUN=true
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
# OAuth access token from the Agent OS connect flow (live only)
BINANCE_MCP_TOKEN=

# Safety: leave unset to require human confirmation on every order.
# CONCLAVE_AUTO_CONFIRM=true

# Persona decisions
#  rules = deterministic rule stand-ins (default, reproducible, no keys)
#  auto  = use an LLM when LLM_API_KEY is set, otherwise rules
#  llm   = require an LLM (a failed call fails closed to NO-GO)
# Copy this file to .env and run `npm run chat:llm` / `npm run demo:llm`.
LLM_MODE=llm

# OpenAI direct:
LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter (has free models, e.g. meta-llama/llama-3.3-70b-instruct:free):
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Attestation: on-chain ballot anchoring on BSC testnet.
# Deploy first with: npm install && npm run deploy:chain  (needs ethers+solc + BSC_PRIVATE_KEY)
CONCLAVE_BALLOT_EMITTER=
BSC_RPC_URL=https://bsc-testnet.publicnode.com
BSC_PRIVATE_KEY=
CONCLAVE_ATTEST_DIR=ballots
